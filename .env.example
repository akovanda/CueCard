# PostgreSQL Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ctx
POSTGRES_USER=ctx
POSTGRES_PASSWORD=ctx

# API Configuration
API_PORT=8000
DATABASE_URL=postgresql+psycopg://ctx:ctx@db:5432/ctx

# Embedding Configuration
# Provider: "openai" for OpenAI embeddings, "local" for deterministic local fallback
EMBEDDING_PROVIDER=local
# OpenAI model to use when EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension is derived from EMBEDDING_MODEL and validated against the DB schema at startup
# OpenAI API key (only needed if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Retrieval Configuration
# Weight for success-rate based reranking (0 = disabled, higher = more weight)
RERANK_WEIGHT=0.1
# How many extra documents to fetch before reranking (overfetch then rerank to top-k)
RETRIEVAL_OVERFETCH=8

# Ranking & Boosting Configuration
# Weight for permanent vote boosts (user feedback)
VOTE_BOOST_WEIGHT=1.0
# Weight for temporary usage boosts (recent retrieval frequency)
USAGE_BOOST_WEIGHT=0.01
# How long usage boosts remain active (in days)
USAGE_BOOST_TTL_DAYS=14

# Background Worker Configuration
# How often the ingestion worker checks for new items (in seconds)
WORKER_POLL_SEC=2
# How many items to process per batch
WORKER_BATCH=32
# How long a worker lease remains valid before abandoned queue items are retried
WORKER_LEASE_SEC=300
# How often to clean up expired usage boosts (in seconds, default 1 hour)
CLEANUP_INTERVAL_SEC=3600

# Security
# Sample local setup enables API key auth by default. Change this before exposing the service anywhere shared.
CUECARD_API_KEY=change-me
# Change the header name if desired (default: X-API-Key)
API_KEY_HEADER=X-API-Key

# CORS (optional)
# Comma-separated list of allowed origins (e.g., http://localhost:5173,https://your.app)
# Empty disables CORS middleware
CORS_ORIGINS=
